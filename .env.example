# Copy to `.env` and fill in for the Supabase project you are pointing at.
# Vercel supplies these at build time, so this file is only for local work.
#
# `SUPABASE_*` is read by server code and the end-to-end tests.
# `VITE_SUPABASE_*` is baked into the browser bundle.
SUPABASE_PROJECT_ID=""
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
